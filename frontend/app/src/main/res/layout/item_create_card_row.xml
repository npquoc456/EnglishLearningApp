<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Card index, photo icon, delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCardIndexBadge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_pill_red"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/badge_red_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Thẻ số 1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSpeakCardTerm"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_blue"
                android:contentDescription="Phát âm từ"
                android:padding="6dp"
                android:src="@drawable/ic_volume"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/btnUploadImage"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_outline_button"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="🖼 Ảnh"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnDeleteCard"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Thuật ngữ * -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="THUẬT NGỮ *"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTerm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_card"
            android:hint="Nhập từ hoặc cụm từ..."
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Định nghĩa * & Nút dịch nhanh Google -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ĐỊNH NGHĨA *"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnQuickTranslate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_blue"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🌐 Google Dịch"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etDefinition"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_card"
            android:hint="Nhập định nghĩa, nghĩa tiếng Việt..."
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Gợi ý nghĩa tiếng Việt khi nhập từ vựng tiếng Anh (Ảnh 3) -->
        <LinearLayout
            android:id="@+id/layoutMeaningSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Gợi ý Google Dịch (chạm để chọn nhanh):"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Row: Phát âm & Loại từ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phát âm (Tùy chọn)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etPhonetic"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_rounded_card"
                    android:hint="/phiên âm IPA/"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loại từ (Tùy chọn)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etWordType"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_rounded_card"
                    android:hint="phrase, noun, verb..."
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ví dụ (Tùy chọn) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Ví dụ (Tùy chọn)"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etExample"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_card"
            android:hint="Nhập câu ví dụ..."
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Từ đồng nghĩa (Tùy chọn) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Từ đồng nghĩa (Tùy chọn)"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etSynonyms"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_card"
            android:hint="Các từ đồng nghĩa, cách nhau dấu phẩy..."
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

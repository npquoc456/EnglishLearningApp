<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_flashcard_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLASHCARD VN"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trang Chủ"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_streak_pill"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_fire" />

                <TextView
                    android:id="@+id/tvHeaderStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="5 ngày"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pill_gray"
                    android:padding="6dp"
                    android:src="@drawable/ic_profile" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_pill_red" />
            </FrameLayout>
        </LinearLayout>

        <!-- Motivation Banner (Burgundy Gradient) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_burgundy_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦ TRÍ NHỚ SIÊU TỐC"
                        android:textColor="#FEE2E2"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerStreakTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chào mừng bạn mới!"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerStreakSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Bắt đầu học thẻ từ vựng để kích hoạt chuỗi phản xạ trí nhớ"
                        android:textColor="#FECDD3"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_streak_pill"
                    android:padding="10dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/primary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- User Greeting & CEFR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreetingSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHÀO MINH, SẴN SÀNG BỨT PHÁ?"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Học tập mỗi ngày"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="CEFR A1 • Sơ cấp"
                android:textColor="@color/badge_purple_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 7-Day Streak Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_streak_pill"
                    android:padding="8dp"
                    android:src="@drawable/ic_fire" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStreakCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bắt đầu chuỗi học tập! ✪"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStreakCardSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Học hôm nay để kích hoạt chuỗi đầu tiên"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 7 dots -->
                <LinearLayout
                    android:id="@+id/layoutStreakDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View android:id="@+id/dotDay1" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@drawable/bg_pill_gray" />
                    <View android:id="@+id/dotDay2" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@drawable/bg_pill_gray" />
                    <View android:id="@+id/dotDay3" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@drawable/bg_pill_gray" />
                    <View android:id="@+id/dotDay4" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@drawable/bg_pill_gray" />
                    <View android:id="@+id/dotDay5" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@drawable/bg_pill_gray" />
                    <View android:id="@+id/dotDay6" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@drawable/bg_pill_gray" />
                    <View android:id="@+id/dotDay7" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@drawable/bg_pill_gray" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Weekly Overview Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng quan tuần này"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWeeklyDateRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuần này"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3 Stat Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Card 1: 142 Thẻ đã ôn -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_deck"
                        app:tint="@color/accent_red" />

                    <TextView
                        android:id="@+id/tvWeeklyReviewedCards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thẻ đã ôn"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvWeeklyReviewedSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="+0 thẻ"
                        android:textColor="@color/accent_red"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: 88% Độ chính xác -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvWeeklyAccuracy"
                        android:layout_width="32dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_pill_gray"
                        android:gravity="center"
                        android:text="0%"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Độ chính xác"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvWeeklyAccuracySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mục tiêu: 85%"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: 12p Thời gian/ngày -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/accent_red" />

                    <TextView
                        android:id="@+id/tvWeeklyStudyTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0p"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian/ngày"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvWeeklyStudyTimeSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 phút"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Chuỗi nhiệt ôn tập Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📅 Chuỗi nhiệt ôn tập"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeatStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_streak_pill"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0 ngày liên tiếp 🔥"
                        android:textColor="@color/accent_red"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 7 Days heat chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- T2 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T2" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/heatDay2" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pill_gray" android:gravity="center" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- T3 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T3" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/heatDay3" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pill_gray" android:gravity="center" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- T4 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T4" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/heatDay4" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pill_gray" android:gravity="center" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- T5 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T5" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/heatDay5" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pill_gray" android:gravity="center" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- T6 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T6" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/heatDay6" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pill_gray" android:gravity="center" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- T7 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T7" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/heatDay7" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pill_gray" android:gravity="center" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CN -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CN" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/heatDayCN" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pill_gray" android:gravity="center" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Heat legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ít hơn" android:textColor="@color/text_muted" android:textSize="10sp" />
                    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:background="@drawable/bg_pill_gray" />
                    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="3dp" android:background="@drawable/bg_pill_red" />
                    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="3dp" android:background="@drawable/bg_burgundy_button" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ôn nhiều" android:textColor="@color/text_muted" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tới hạn hôm nay (SRS Flashcard due card) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_blue"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="⏱ Tới hạn hôm nay"
                            android:textColor="@color/badge_blue_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDueCardCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="18 thẻ cần ôn"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Duy trì trí nhớ dài hạn theo thuật toán SRS"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_pill_blue"
                        android:padding="12dp"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/primary" />
                </LinearLayout>

                <!-- Multi-segment progress bar -->
                <ProgressBar
                    android:id="@+id/pbSRS"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary" />

                <!-- Legend: Đã thuộc, Đang học, Mới -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSrsMastered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Đã thuộc: 0"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSrsLearning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="● Đang học: 0"
                        android:textColor="@color/accent_red"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSrsNew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="● Mới: 0"
                        android:textColor="@color/badge_blue_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutSRSControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Chiều ôn tập:"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_card"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="⇄ Việt → gõ Anh"
                            android:textColor="@color/accent_red"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_gray"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="👁 Anh → nhớ Việt"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action Button Ôn ngay (chỉ hiển thị khi có thẻ cần ôn) -->
                <LinearLayout
                    android:id="@+id/layoutSRSAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStartSRS"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        app:backgroundTint="@color/primary"
                        android:text="▶ Ôn ngay  ~5 phút"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_outline_button"
                        android:padding="12dp"
                        android:src="@drawable/ic_shuffle"
                        app:tint="@color/primary" />
                </LinearLayout>

                <!-- Trạng thái trống: Khi không có thẻ nào cần ôn hôm nay (Ảnh 1) -->
                <LinearLayout
                    android:id="@+id/layoutNoCardsDue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_blue"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎉 Tuyệt vời! Chưa có thẻ nào cần ôn hôm nay"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hãy tạo thêm bộ thẻ để bắt đầu hành trình học tập."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnCreateDeckFromHome"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        app:backgroundTint="@color/primary"
                        android:text="+ Tạo bộ thẻ mới"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section Cần củng cố gấp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📖 Cần củng cố gấp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUrgentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="3 từ"
                android:textColor="@color/badge_red_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Urgent RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUrgentCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvEmptyHomeUrgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center"
            android:padding="20dp"
            android:text="Tuyệt vời! Bạn chưa có từ vựng nào cần củng cố gấp."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
